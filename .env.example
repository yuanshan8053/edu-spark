# 本地验证：node scripts/setup.mjs 生成 .env.local。不要直接使用示例密码。
DATA_BACKEND=local
ASSET_BACKEND=local
LOCAL_DATA_DIR=.local-data
APP_ORIGIN=http://localhost:3000
# node scripts/setup.mjs 生成密码哈希和随机会话密钥。
TEACHER_PASSWORD_HASH=
SESSION_SECRET=
# 云端使用 iga / blob，无需自行配置 TOS 桶或平台访问凭证。
# 生产环境拒绝 local，除非只用于本机验证并显式 LOCAL_ONLY=1。
# DATA_BACKEND=iga
# ASSET_BACKEND=blob
# APP_ORIGIN=https://正式固定域名
# 家庭真机测试时关闭老师端（后续配置密码后再关闭这两个开关）。
# TEACHER_DISABLED=1
# NEXT_PUBLIC_TEACHER_DISABLED=1
# 可选：改为 ASSET_BACKEND=tos 时才需要下面的 TOS 配置。
# TOS_REGION=cn-shanghai
# TOS_ENDPOINT=tos-cn-shanghai.volces.com
# TOS_BUCKET=
# TOS_ACCESS_KEY_ID=
# TOS_SECRET_ACCESS_KEY=
# TOS_SESSION_TOKEN=
